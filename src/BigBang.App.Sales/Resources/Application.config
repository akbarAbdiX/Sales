<?xml version="1.0" encoding="utf-8"?>
<configuration xmlns="http://schemas.bigbang.io/applicationconfig">
	<application name="Sales" displayName="Sales">
		<migrationConfig assembly="BigBang.App.Sales.Migrations.dll" />
		<modules>
			<extendedModule
			moduleName="SalesERPSuiteCoreExtended"
			assemblyName="BigBang.App.Sales.ERPSuiteCore.Extended"
			application="ERPSuiteCore" />
		</modules>
		<generatorConfig generationSource="DML"
						 defaultModuleName="DefaultModule"
						 assembly="BigBang.App.Sales.Domain"
						 namespace="BigBang.App.Sales.Domain"
						 applicationPrefix="SAL"
						 domainType="Project">
			<DML name="BigBang.App.Sales.DML" />
			<moduleDefinitions>
				<moduleDefinition name="SOP" pattern="^(tblSOP)"/>
			</moduleDefinitions>
			<commandFilters>
				<regexFilter pattern="^(.*)$" filterType="Accept" />
			</commandFilters>
			<tableNameRefactors>
				<pluralRefactor />
				<regexRefactor refactorFormat="{0}" searchPattern="^tbl(.+)$" />
			</tableNameRefactors>
		</generatorConfig>
	</application>
</configuration>