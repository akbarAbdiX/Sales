<?xml version="1.0" encoding="utf-8"?>
<hibernate-mapping assembly="BigBang.App.Sales.Domain" namespace="BigBang.App.Sales.Domain" xmlns="urn:nhibernate-mapping-2.2">
  <class name="SALSOPDocumentFlow" table="[tblSOPDocumentFlow]" schema="[$sales_database_name$].dbo" persister="BigBang.NHibernateLibrary.DynamicRestriction.BigBangSingleTableEntityPersister,  BigBang.NHibernateLibrary">
    <id name="ID" type="Int32">
      <column name="ID" not-null="true" precision="10" scale="0" sql-type="int" />
      <generator class="identity" />
    </id>
    <property name="Level" type="Int32">
      <column name="Level" not-null="true" precision="10" scale="0" sql-type="int" />
    </property>
    <many-to-one name="DocumentType" class="BigBang.App.Sales.Domain.SALSOPDocumentType,BigBang.App.Sales.Domain">
      <column name="DocumentTypeID" not-null="true" precision="10" scale="0" sql-type="int" />
    </many-to-one>
    <filter name="DynamicRestriction" condition="1=1" />
  </class>
</hibernate-mapping>