<?xml version="1.0" encoding="utf-8"?>
<hibernate-mapping assembly="BigBang.App.Sales.Domain" namespace="BigBang.App.Sales.Domain" xmlns="urn:nhibernate-mapping-2.2">
  <class name="SALSOPAdjustment" table="[tblSOPAdjustment]" schema="[$sales_database_name$].dbo" persister="BigBang.NHibernateLibrary.DynamicRestriction.BigBangSingleTableEntityPersister,  BigBang.NHibernateLibrary">
    <id name="ID" type="Int32">
      <column name="ID" not-null="true" precision="10" scale="0" sql-type="int" />
      <generator class="identity" />
    </id>
    <property name="Code" type="Int32">
      <column name="Code" not-null="true" precision="10" scale="0" sql-type="int" />
    </property>
    <property name="Rate" type="Decimal">
      <column name="Rate" not-null="true" precision="5" scale="2" sql-type="decimal" default="((0))" />
    </property>
    <property name="Amount" type="Decimal">
      <column name="Amount" not-null="true" precision="18" scale="0" sql-type="decimal" default="((0))" />
    </property>
    <property name="IsDefault" type="Boolean">
      <column name="IsDefault" not-null="true" sql-type="bit" />
    </property>
    <property name="Title" type="String">
      <column name="Title" not-null="true" sql-type="nvarchar" length="100" />
    </property>
    <property name="IsAppliedTax" type="Boolean">
      <column name="IsAppliedTax" not-null="true" sql-type="bit" />
    </property>
    <property name="FromDate" type="DateTime">
      <column name="FromDate" not-null="false" sql-type="datetime" />
    </property>
    <property name="ToDate" type="DateTime">
      <column name="ToDate" not-null="false" sql-type="datetime" />
    </property>
    <many-to-one name="AdjustmentType" class="BigBang.App.Sales.Domain.SALSOPAdjustmentType,BigBang.App.Sales.Domain">
      <column name="AdjustmentTypeID" not-null="true" precision="10" scale="0" sql-type="int" />
    </many-to-one>
    <bag cascade="save-update" name="SOPDocumentAdjustments" inverse="true" generic="true" persister="BigBang.NHibernateLibrary.DynamicRestriction.BigBangOneToManyPersister,  BigBang.NHibernateLibrary">
      <key>
        <column name="AdjustmentID" />
      </key>
      <one-to-many class="BigBang.App.Sales.Domain.SALSOPDocumentAdjustment,BigBang.App.Sales.Domain" />
      <filter name="DynamicRestriction" condition="1=1" />
    </bag>
    <filter name="DynamicRestriction" condition="1=1" />
  </class>
</hibernate-mapping>