<?xml version="1.0" encoding="utf-8"?>
<hibernate-mapping assembly="BigBang.App.Sales.Domain" namespace="BigBang.App.Sales.Domain" xmlns="urn:nhibernate-mapping-2.2">
  <class name="SALSOPPaymentTermsType" table="[tblSOPPaymentTermsType]" schema="[$sales_database_name$].dbo" persister="BigBang.NHibernateLibrary.DynamicRestriction.BigBangSingleTableEntityPersister,  BigBang.NHibernateLibrary">
    <id name="Id" type="Int32">
      <column name="Id" not-null="true" precision="10" scale="0" sql-type="int" />
      <generator class="identity" />
    </id>
    <bag cascade="save-update" name="SOPPaymentTerms" inverse="true" generic="true" persister="BigBang.NHibernateLibrary.DynamicRestriction.BigBangOneToManyPersister,  BigBang.NHibernateLibrary">
      <key>
        <column name="PaymentTermsTypeId" />
      </key>
      <one-to-many class="BigBang.App.Sales.Domain.SALSOPPaymentTerm,BigBang.App.Sales.Domain" />
      <filter name="DynamicRestriction" condition="1=1" />
    </bag>
    <property name="Code" type="Int32">
      <column name="Code" not-null="true" precision="10" scale="0" sql-type="int" />
    </property>
    <property name="Description" type="String">
      <column name="Description" not-null="true" sql-type="nvarchar" length="100" />
    </property>
    <filter name="DynamicRestriction" condition="1=1" />
  </class>
</hibernate-mapping>