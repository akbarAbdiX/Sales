<?xml version="1.0" encoding="utf-8"?>
<configuration xmlns="http://schemas.bigbang.io/configuration/BigBang.Metadata.Generator.Configuration.BigBangConfig.ApplicationCatalogConfig">
  <environment name="SalesDev" />
  <!--<serviceBus name="srv.bigbang.dotin.ir" port="9092" type="Kafka" />-->
  <!--<serviceBus name="localhost" port="61616" type="ActiveMQ" />-->
  <!--<logging local="true" name="srv.bigbang.dotin.ir" port="5000" />-->
  <logging local="true" />
  <!--<serverInfo useHsts="true">-->
  <serverInfo>
    <defaultUser username="admin" password="123456" />
    <session secretKey="9865F053-DB48-48C8-AC79-6168E3E95A5B" />
    <!--<referrerPolicy policy="NoReferrer" />-->
  </serverInfo>
  <attachment>
	  <storages>
		  <database name="SalesStorage" connectionstring="Data Source=.;Initial Catalog=BigBang_Sales_Core;Integrated Security=True;Encrypt=False">
		  </database>
	  </storages>
  </attachment>
  <userRegistration isActive="true" />
  <applicationCatalog safeMode="false">
	  <database dataSource="." encrypt="false" connectTimeout="60" commandTimeout="30" integratedSecurity="true" persistSecurityInfo="true" maxPoolSize="100"/>
    <applications>
      <application name="BigBang" assemblyName="BigBang.App" />
      <application name="Sales" assemblyName="BigBang.App.Sales" databaseName="BigBang_Sales" />
      <application name="LocalAuthentication" assemblyName="BigBang.App.LocalAuthentication" databaseName="BigBang_Sales_Core" />
      <application name="PersonalInformation" assemblyName="BigBang.App.PersonalInformation" databaseName="BigBang_Sales_Core" />
      <application name="ERPSuiteCore" assemblyName="BigBang.App.ERPSuiteCore" databaseName="BigBang_Sales_SuiteCore" />
      <application name="Attachment" assemblyName="BigBang.App.Attachment" databaseName="BigBang_Sales_Core"/>
	  <application name="ImportExport" assemblyName="BigBang.App.ImportExport" databaseName="BigBang_Sales_Core" />
	  <application name="Authentication" assemblyName="BigBang.App.Authentication" />
    </applications>
  </applicationCatalog>
</configuration>